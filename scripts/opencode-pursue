#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
cd "$project_dir"

runs=1
resume=false
commit_after_run=false

usage() {
  cat <<'EOF'
Usage: scripts/opencode-pursue [--runs N] [--resume] [--commit] [--quota-threshold PERCENT] [--] [operator direction...]

Run the autonomous Scaffold agent up to N times. Each invocation starts a
fresh OpenCode session by default. Pass --resume to use the exact session
recorded locally in .opencode/pursue-session. Within one --runs N invocation,
successful later runs continue the session created or resumed by its first run.

Trailing arguments are the operator direction; they reach the agent as
$ARGUMENTS in the pursue command template. A direction pins the invocation to a
single run, so --runs may not exceed 1 alongside one: the same direction
re-injected into a resumed session restates an instruction the agent has
already carried out. Continue a directed pursuit undirected instead, which
leaves the direction where it belongs, in the session history:

  scripts/opencode-pursue -- "advance proposals/<name>.md, step 1 only"
  scripts/opencode-pursue --runs 4 --resume

Before each new run, scripts/zquota applies the default 90% quota gate. A
closed gate exits 75 without starting an agent; use the launchd helper for
periodic wakeup. Raw transcripts are written to ignored .opencode/runs; follow
docs/AGENT_ACTIVITY.md for the durable operator-facing account.

Pass --commit to use a separate, read-only Codex review after all successful
runs. The wrapper verifies the worktree, asks Codex for a Conventional Commit
subject, then stages and commits the verified changes itself. --commit refuses
to start from a dirty worktree and never commits a non-completed run.
EOF
}

quota_threshold=${ZQUOTA_THRESHOLD:-90}

while (($#)); do
  case "$1" in
    --runs)
      (($# >= 2)) || { echo "--runs requires a positive integer" >&2; exit 2; }
      runs="$2"
      shift 2
      ;;
    --quota-threshold)
      (($# >= 2)) || { echo "--quota-threshold requires an integer percentage" >&2; exit 2; }
      quota_threshold="$2"
      shift 2
      ;;
    --resume)
      resume=true
      shift
      ;;
    --commit)
      commit_after_run=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

[[ "$runs" =~ ^[1-9][0-9]*$ ]] || {
  echo "--runs must be a positive integer" >&2
  exit 2
}
[[ "$quota_threshold" =~ ^[0-9]+$ ]] && ((quota_threshold <= 100)) || {
  echo "--quota-threshold must be an integer from 0 through 100" >&2
  exit 2
}
if (($# > 0)) && ((runs > 1)); then
  echo "An operator direction pins the pursuit to a single run; --runs must be 1 alongside one." >&2
  echo "Continue a directed pursuit undirected, which keeps the direction in the session history:" >&2
  echo "  scripts/opencode-pursue -- \"<direction>\"" >&2
  echo "  scripts/opencode-pursue --runs $runs --resume" >&2
  exit 2
fi

if "$commit_after_run" && [[ -n "$(git status --porcelain)" ]]; then
  echo "--commit requires a clean worktree before pursuit starts." >&2
  exit 2
fi

run_dir="$project_dir/.opencode/runs"
session_file="$project_dir/.opencode/pursue-session"
mkdir -p "$run_dir"

session_id=""
if "$resume" && [[ -f "$session_file" ]]; then
  session_id=$(tr -d '[:space:]' < "$session_file")
fi
if "$resume" && [[ -z "$session_id" ]]; then
  echo "--resume requires a session recorded in .opencode/pursue-session" >&2
  exit 2
fi

current_log=""
on_interrupt() {
  echo "Autonomous pursuit interrupted. Raw transcript: ${current_log:-not yet created}" >&2
  echo "Review docs/AGENT_ACTIVITY.md for the last durable milestone state." >&2
  exit 130
}
trap on_interrupt INT TERM

latest_activity_status() {
  sed -n 's/^\*\*Status:\*\*[[:space:]]*\([^[:space:]]*\).*/\1/p' \
    "$project_dir/docs/AGENT_ACTIVITY.md" | tail -n 1
}

verify_for_commit() {
  git diff --check
  python3 scripts/generate_qa_scoreboard.py
  python3 scripts/lint_axioms.py
  python3 scripts/check_citations.py
  python3 scripts/check_markdown_links.py
  lake build
  python3 scripts/check_build_completeness.py
  git diff --check
}

commit_verified_pursuit() {
  local activity_status commit_message_file commit_subject codex_prompt

  if [[ -z "$(git status --porcelain)" ]]; then
    echo "No worktree changes to commit after successful pursuit."
    return
  fi

  activity_status=$(latest_activity_status)
  if [[ "$activity_status" != "completed" ]]; then
    echo "Refusing to commit: latest activity status is '${activity_status:-missing}', not completed." >&2
    exit 1
  fi

  verify_for_commit

  command -v codex >/dev/null 2>&1 || {
    echo "--commit requires the Codex CLI to be installed and available on PATH." >&2
    exit 1
  }
  commit_message_file=$(mktemp "$run_dir/codex-commit-message.XXXXXX")
  codex_prompt='You are the independent commit steward for this repository. Inspect the current git diff and the latest completed entry in docs/AGENT_ACTIVITY.md. Do not modify files or run write commands. Return exactly one Conventional Commit subject line (for example: feat(sgt): add spectral bridge). It must be at most 72 characters, begin with feat, fix, docs, chore, refactor, or test, and contain no explanation.'
  codex exec --ephemeral --sandbox read-only \
    --cd "$project_dir" --output-last-message "$commit_message_file" "$codex_prompt"
  commit_subject=$(tr -d '\r' < "$commit_message_file")
  rm -f "$commit_message_file"

  if [[ -z "$commit_subject" || "$commit_subject" == *$'\n'* ||
    ${#commit_subject} -gt 72 ||
    ! "$commit_subject" =~ ^(feat|fix|docs|chore|refactor|test)(\([a-z0-9][a-z0-9_-]*\))?:\ .+ ]]; then
    echo "Codex returned an invalid Conventional Commit subject; refusing to commit." >&2
    exit 1
  fi

  git add -A
  git diff --cached --check
  git commit -m "$commit_subject"
}

for ((run_number = 1; run_number <= runs; run_number++)); do
  echo "==> Checking quota before pursuit run $run_number/$runs"
  set +e
  "$script_dir/zquota" --threshold "$quota_threshold"
  quota_status=$?
  set -e
  if ((quota_status == 10)); then
    echo "Quota gate is closed; no pursuit run was started. Resume after the reported reset time." >&2
    exit 75
  elif ((quota_status != 0)); then
    echo "Quota check failed; refusing to start a pursuit run." >&2
    exit "$quota_status"
  fi

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  current_log="$run_dir/${timestamp}-run-${run_number}.log"

  echo "==> Pursuit run $run_number/$runs"
  echo "    Transcript: ${current_log#$project_dir/}"
  if [[ -n "$session_id" ]]; then
    echo "    Resuming session: $session_id"
    set +e
    opencode run \
      --session "$session_id" \
      --command pursue \
      --agent scaffold \
      --model zhipuai-coding-plan/glm-5.3 \
      --variant high \
      --auto \
      --title "Scaffold autonomous pursuit" \
      "$@" 2>&1 | tee "$current_log"
    status=${PIPESTATUS[0]}
    set -e
  else
    set +e
    opencode run \
      --command pursue \
      --agent scaffold \
      --model zhipuai-coding-plan/glm-5.3 \
      --variant high \
      --auto \
      --title "Scaffold autonomous pursuit" \
      "$@" 2>&1 | tee "$current_log"
    status=${PIPESTATUS[0]}
    set -e

    if ((status == 0)); then
      session_id=$(opencode session list --max-count 1 --format json \
        | sed -n 's/^[[:space:]]*"id": "\([^"]*\)".*/\1/p' \
        | head -n 1)
      if [[ -z "$session_id" ]]; then
        echo "Could not determine the new OpenCode session ID; refusing an unsafe implicit resume." >&2
        exit 1
      fi
      printf '%s\n' "$session_id" > "$session_file"
      echo "    Session recorded: $session_id"
    fi
  fi

  if ((status != 0)); then
    echo "Pursuit run failed with exit status $status. Transcript: $current_log" >&2
    exit "$status"
  fi
done

if "$commit_after_run"; then
  commit_verified_pursuit
fi

echo "Pursuit budget exhausted after $runs run(s)."
echo "Review docs/EXECUTION_PLAN.md and docs/AGENT_ACTIVITY.md before resuming."
