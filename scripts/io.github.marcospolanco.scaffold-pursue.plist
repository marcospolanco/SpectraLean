<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.marcospolanco.scaffold-pursue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec /Users/marcos/Developer/scaffold/scripts/opencode-pursue --runs 1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/marcos/Developer/scaffold</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/marcos/Developer/scaffold/.opencode/scaffold-pursue.launchd.log</string>
