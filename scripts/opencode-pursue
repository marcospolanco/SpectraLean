#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
cd "$project_dir"

runs=1
resume=false

usage() {
  cat <<'EOF'
Usage: scripts/opencode-pursue [--runs N] [--resume] [--quota-threshold PERCENT] [--] [operator direction...]

Run the autonomous Scaffold agent up to N times. Each invocation starts a
fresh OpenCode session by default. Pass --resume to use the exact session
recorded locally in .opencode/pursue-session. Within one --runs N invocation,
successful later runs continue the session created or resumed by its first run.
Before each new run, scripts/zquota applies the default 90% quota gate. A
closed gate exits 75 without starting an agent; use the launchd helper for
periodic wakeup. Raw transcripts are written to ignored .opencode/runs; follow
docs/AGENT_ACTIVITY.md for the durable operator-facing account.
EOF
}

quota_threshold=${ZQUOTA_THRESHOLD:-90}

while (($#)); do
  case "$1" in
    --runs)
      (($# >= 2)) || { echo "--runs requires a positive integer" >&2; exit 2; }
      runs="$2"
      shift 2
      ;;
    --quota-threshold)
      (($# >= 2)) || { echo "--quota-threshold requires an integer percentage" >&2; exit 2; }
      quota_threshold="$2"
      shift 2
      ;;
    --resume)
      resume=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

[[ "$runs" =~ ^[1-9][0-9]*$ ]] || {
  echo "--runs must be a positive integer" >&2
  exit 2
}
[[ "$quota_threshold" =~ ^[0-9]+$ ]] && ((quota_threshold <= 100)) || {
  echo "--quota-threshold must be an integer from 0 through 100" >&2
  exit 2
}
run_dir="$project_dir/.opencode/runs"
session_file="$project_dir/.opencode/pursue-session"
mkdir -p "$run_dir"

session_id=""
if "$resume" && [[ -f "$session_file" ]]; then
  session_id=$(tr -d '[:space:]' < "$session_file")
fi
if "$resume" && [[ -z "$session_id" ]]; then
  echo "--resume requires a session recorded in .opencode/pursue-session" >&2
  exit 2
fi

current_log=""
on_interrupt() {
  echo "Autonomous pursuit interrupted. Raw transcript: ${current_log:-not yet created}" >&2
  echo "Review docs/AGENT_ACTIVITY.md for the last durable milestone state." >&2
  exit 130
}
trap on_interrupt INT TERM

for ((run_number = 1; run_number <= runs; run_number++)); do
  echo "==> Checking quota before pursuit run $run_number/$runs"
  set +e
  "$script_dir/zquota" --threshold "$quota_threshold"
  quota_status=$?
  set -e
  if ((quota_status == 10)); then
    echo "Quota gate is closed; no pursuit run was started. Resume after the reported reset time." >&2
    exit 75
  elif ((quota_status != 0)); then
    echo "Quota check failed; refusing to start a pursuit run." >&2
    exit "$quota_status"
  fi

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  current_log="$run_dir/${timestamp}-run-${run_number}.log"

  echo "==> Pursuit run $run_number/$runs"
  echo "    Transcript: ${current_log#$project_dir/}"
  if [[ -n "$session_id" ]]; then
    echo "    Resuming session: $session_id"
    set +e
    opencode run \
      --session "$session_id" \
      --command pursue \
      --agent scaffold \
      --model zhipuai-coding-plan/glm-5.3 \
      --variant high \
      --auto \
      --title "Scaffold autonomous pursuit" \
      "$@" 2>&1 | tee "$current_log"
    status=${PIPESTATUS[0]}
    set -e
  else
    set +e
    opencode run \
      --command pursue \
      --agent scaffold \
      --model zhipuai-coding-plan/glm-5.3 \
      --variant high \
      --auto \
      --title "Scaffold autonomous pursuit" \
      "$@" 2>&1 | tee "$current_log"
    status=${PIPESTATUS[0]}
    set -e

    if ((status == 0)); then
      session_id=$(opencode session list --max-count 1 --format json \
        | sed -n 's/^[[:space:]]*"id": "\([^"]*\)".*/\1/p' \
        | head -n 1)
      if [[ -z "$session_id" ]]; then
        echo "Could not determine the new OpenCode session ID; refusing an unsafe implicit resume." >&2
        exit 1
      fi
      printf '%s\n' "$session_id" > "$session_file"
      echo "    Session recorded: $session_id"
    fi
  fi

  if ((status != 0)); then
    echo "Pursuit run failed with exit status $status. Transcript: $current_log" >&2
    exit "$status"
  fi
done

echo "Pursuit budget exhausted after $runs run(s)."
echo "Review docs/EXECUTION_PLAN.md and docs/AGENT_ACTIVITY.md before resuming."
