#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
cd "$project_dir"

exec opencode run \
  --command pursue \
  --agent scaffold \
  --model zhipuai-coding-plan/glm-5.3 \
  --variant high \
  --auto \
  --title "Scaffold autonomous pursuit" \
  "$@"
